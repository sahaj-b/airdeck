{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airdeck.local/schema/layout.schema.json",
  "title": "Airdeck LayoutDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "schemaVersion",
    "defaultOrientation",
    "sections",
    "assets"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "schemaVersion": {
      "const": 1
    },
    "defaultOrientation": {
      "enum": ["landscape", "portrait"]
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "portrait": {
          "$ref": "#/$defs/rect"
        },
        "landscape": {
          "$ref": "#/$defs/rect"
        }
      }
    },
    "binding": {
      "enum": [
        "south",
        "east",
        "west",
        "north",
        "dpadUp",
        "dpadDown",
        "dpadLeft",
        "dpadRight",
        "leftShoulder",
        "rightShoulder",
        "leftStick",
        "rightStick",
        "start",
        "back",
        "guide",
        "leftTrigger",
        "rightTrigger"
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "rect", "label", "visible"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "type": {
          "enum": ["button", "dpad", "joystick", "trigger", "label", "image"]
        },
        "rect": {
          "$ref": "#/$defs/rect"
        },
        "label": {
          "type": "string",
          "maxLength": 40
        },
        "visible": {
          "type": "boolean"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["up", "down", "left", "right"],
          "properties": {
            "up": {
              "const": "dpadUp"
            },
            "down": {
              "const": "dpadDown"
            },
            "left": {
              "const": "dpadLeft"
            },
            "right": {
              "const": "dpadRight"
            }
          }
        },
        "orientations": {
          "$ref": "#/$defs/orientation"
        },
        "asset": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rect", "controls"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "rect": {
          "$ref": "#/$defs/rect"
        },
        "controls": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/control"
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "path": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$"
        }
      }
    }
  }
}
