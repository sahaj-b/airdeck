{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airdeck.local/schema/layout.schema.json",
  "title": "Airdeck LayoutDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "schemaVersion",
    "defaultOrientation",
    "referenceDimension",
    "gap",
    "gapMax",
    "sections",
    "assets"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "schemaVersion": {
      "const": 1
    },
    "defaultOrientation": {
      "enum": ["landscape", "portrait"]
    },
    "referenceDimension": {
      "const": "height",
      "description": "V1 measures section widths, padding, control positions, and control sizes from the composition height."
    },
    "gap": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "The minimum gap between ordered sections, as a fraction of the composition height."
    },
    "gapMax": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "The maximum gap between ordered sections. Spare wide-screen space reaches gaps after flexible sections reach maxWidth."
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -2,
          "maximum": 2,
          "description": "Horizontal offset from the section content center, in reference-dimension units. Positive is right."
        },
        "y": {
          "type": "number",
          "minimum": -2,
          "maximum": 2,
          "description": "Vertical offset from the section content center, in reference-dimension units. Positive is down."
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "The horizontal pivot inside the control. 0 is the left edge and 1 is the right edge."
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "The vertical pivot inside the control. 0 is the top edge and 1 is the bottom edge."
        }
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2,
          "description": "Width as a fraction of the section reference dimension."
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2,
          "description": "Height as a fraction of the section reference dimension."
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "anchor", "size"],
      "properties": {
        "position": {
          "$ref": "#/$defs/point"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "size": {
          "$ref": "#/$defs/size"
        }
      }
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "portrait": {
          "$ref": "#/$defs/geometry"
        },
        "landscape": {
          "$ref": "#/$defs/geometry"
        }
      }
    },
    "padding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right", "top", "bottom"],
      "properties": {
        "left": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "right": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "top": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "bottom": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        }
      }
    },
    "binding": {
      "enum": [
        "south",
        "east",
        "west",
        "north",
        "dpadUp",
        "dpadDown",
        "dpadLeft",
        "dpadRight",
        "leftShoulder",
        "rightShoulder",
        "leftStick",
        "rightStick",
        "start",
        "back",
        "guide",
        "leftTrigger",
        "rightTrigger"
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "geometry", "label", "visible"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "type": {
          "enum": ["button", "dpad", "joystick", "trigger", "label", "image"]
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "shape": {
          "description": "Visual shape applied by the renderer. Defaults to rect.",
          "enum": ["circle", "pill", "rect"]
        },
        "label": {
          "type": "string",
          "maxLength": 40
        },
        "visible": {
          "type": "boolean"
        },
        "hitOnly": {
          "type": "boolean",
          "description": "When true, creates a touch hit target but no visible element. Use for invisible filler areas that route touches to a binding."
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["up", "down", "left", "right"],
          "properties": {
            "up": {
              "const": "dpadUp"
            },
            "down": {
              "const": "dpadDown"
            },
            "left": {
              "const": "dpadLeft"
            },
            "right": {
              "const": "dpadRight"
            }
          }
        },
        "orientations": {
          "$ref": "#/$defs/orientation"
        },
        "asset": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "aspectRatio",
        "minWidth",
        "maxWidth",
        "flexGrow",
        "flexShrink",
        "protected",
        "padding",
        "controls"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "aspectRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4,
          "description": "Base section width divided by the composition reference dimension."
        },
        "minWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4,
          "description": "Minimum section width divided by the composition reference dimension."
        },
        "maxWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4,
          "description": "Maximum section width divided by the composition reference dimension."
        },
        "flexGrow": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "flexShrink": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "protected": {
          "type": "boolean",
          "description": "Protected sections keep their authored width while unprotected flexible sections shrink."
        },
        "padding": {
          "$ref": "#/$defs/padding"
        },
        "controls": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/control"
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "path": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$"
        }
      }
    }
  }
}
