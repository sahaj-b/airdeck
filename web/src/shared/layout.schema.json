{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airdeck.local/schema/layout.schema.json",
  "title": "Airdeck LayoutDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "schemaVersion",
    "defaultOrientation",
    "sections",
    "assets"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "schemaVersion": {
      "const": 2
    },
    "defaultOrientation": {
      "enum": ["landscape", "portrait"]
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "relativeWidth", "controls"],
          "properties": {
            "id": { "const": "left" },
            "relativeWidth": { "$ref": "#/$defs/relativeWidth" },
            "relativeMinWidth": { "$ref": "#/$defs/relativeMinWidth" },
            "controls": { "$ref": "#/$defs/controlsArray" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "relativeWidth", "controls"],
          "properties": {
            "id": { "const": "center" },
            "relativeWidth": { "$ref": "#/$defs/relativeWidth" },
            "relativeMinWidth": { "$ref": "#/$defs/relativeMinWidth" },
            "controls": { "$ref": "#/$defs/controlsArray" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "relativeWidth", "controls"],
          "properties": {
            "id": { "const": "right" },
            "relativeWidth": { "$ref": "#/$defs/relativeWidth" },
            "relativeMinWidth": { "$ref": "#/$defs/relativeMinWidth" },
            "controls": { "$ref": "#/$defs/controlsArray" }
          }
        }
      ],
      "items": false
    },
    "assets": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -2,
          "maximum": 2,
          "description": "Horizontal offset from the section center, in viewport-height units. Positive is right."
        },
        "y": {
          "type": "number",
          "minimum": -2,
          "maximum": 2,
          "description": "Vertical offset from the section center, in viewport-height units. Positive is down."
        }
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2,
          "description": "Width as a fraction of viewport height."
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2,
          "description": "Height as a fraction of viewport height."
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "size"],
      "properties": {
        "position": { "$ref": "#/$defs/point" },
        "size": { "$ref": "#/$defs/size" }
      }
    },
    "binding": {
      "enum": [
        "south",
        "east",
        "west",
        "north",
        "dpadUp",
        "dpadDown",
        "dpadLeft",
        "dpadRight",
        "leftShoulder",
        "rightShoulder",
        "leftStick",
        "rightStick",
        "start",
        "back",
        "guide",
        "leftTrigger",
        "rightTrigger"
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "geometry", "label"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "type": {
          "enum": ["button", "dpad", "joystick", "trigger", "label", "image", "hitfill"]
        },
        "geometry": { "$ref": "#/$defs/geometry" },
        "shape": {
          "description": "Visual shape applied by the renderer. Defaults to rect.",
          "enum": ["round", "rect"]
        },
        "label": {
          "type": "string",
          "maxLength": 40
        },
        "parentId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "description": "Required for hitfill, must reference a non-hitfill control in the same section."
        },
        "binding": { "$ref": "#/$defs/binding" },
        "bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["up", "down", "left", "right"],
          "properties": {
            "up": { "const": "dpadUp" },
            "down": { "const": "dpadDown" },
            "left": { "const": "dpadLeft" },
            "right": { "const": "dpadRight" }
          }
        },
        "asset": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "hitfill" } } },
          "then": { "required": ["parentId"] },
          "else": { "not": { "required": ["parentId"] } }
        },
        {
          "if": { "properties": { "type": { "const": "hitfill" } } },
          "then": {
            "properties": {
              "binding": false,
              "bindings": false,
              "asset": false
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "hitfill" } } },
          "then": {
            "properties": {
              "shape": { "enum": ["rect"] }
            }
          }
        }
      ]
    },
    "relativeWidth": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 4,
      "description": "Section width in viewport-height units."
    },
    "relativeMinWidth": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 4,
      "description": "Minimum section width in viewport-height units for narrow viewports."
    },
    "controlsArray": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/control" }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "path": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,127}$"
        }
      }
    }
  }
}
